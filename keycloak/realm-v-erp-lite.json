{
  "realm": "v-erp-lite",
  "displayName": "V-ERP Lite",
  "enabled": true,
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "organizationsEnabled": true,

  "roles": {
    "realm": [
      { "name": "admin",         "description": "Full system access" },
      { "name": "operator",      "description": "Operational access" },
      { "name": "businessOwner", "description": "Tenant owner" }
    ]
  },

  "clients": [
    {
      "clientId": "v-erp-app",
      "name": "V-ERP Lite Frontend",
      "protocolMappers": [
        {
          "name": "tenant-code-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_code",
            "claim.name": "tenant_code",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "description": "Public PKCE client for the SPA frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "http://localhost:5174",
        "http://localhost:8081"
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "organization"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "v-erp-admin",
      "name": "V-ERP Lite Admin Client",
      "description": "Confidential service-account client for Keycloak admin operations",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "v-erp-admin-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],

  "users": [
    {
      "username": "service-account-v-erp-admin",
      "enabled": true,
      "serviceAccountClientId": "v-erp-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "manage-realm",
          "view-users",
          "query-users",
          "query-groups",
          "manage-clients",
          "view-clients"
        ]
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "YOUR_GOOGLE_CLIENT_ID",
        "clientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
        "useJwksUrl": "true"
      }
    }
  ]
}
