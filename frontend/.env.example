VITE_API_BASE_URL=http://localhost:8081
VITE_KEYCLOAK_URL=http://localhost:8181
VITE_KEYCLOAK_REALM=v-erp-lite
VITE_KEYCLOAK_CLIENT_ID=v-erp-app

# Optional: pin a specific wallet id for the seller dashboard (override).
# Leave unset — the dashboard resolves the logged-in seller's wallet via
# GET /wallets/me. Only set this to demo a specific wallet.
# VITE_SELLER_WALLET_ID=
