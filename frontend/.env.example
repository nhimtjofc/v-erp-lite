VITE_API_BASE_URL=http://localhost:8081
VITE_KEYCLOAK_URL=http://localhost:8181
VITE_KEYCLOAK_REALM=v-erp-lite
VITE_KEYCLOAK_CLIENT_ID=v-erp-app

# Wallet/payout dashboard data source: "real" hits the backend, anything else uses mock.
VITE_WALLET_API=mock
# Optional: pin a specific wallet id for the seller dashboard while the
# User→Business linkage is pending (useful for single-seller demos).
# VITE_SELLER_WALLET_ID=
